[Unit]
Description=Production gyro-l llama inference server
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/home/joe/src/llama-gyro/build/bin/llama-server -m /home/joe/models/gyro-l/Qwen3.8-Flash-Next-Gyro-L-abliterated-TQ3_0.gguf --alias gyro-l --n-gpu-layers 999 --split-mode layer --tensor-split 0.975,1.025 --flash-attn on --ngram-on-disk --ctx-size 128000 --cache-type-k q8_0 --cache-type-v q8_0 --parallel 1 --jinja --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.05 --host 127.0.0.1 --port 8081
Restart=always
RestartSec=10
TimeoutStartSec=1800
TimeoutStopSec=120
KillSignal=SIGTERM

[Install]
WantedBy=default.target
