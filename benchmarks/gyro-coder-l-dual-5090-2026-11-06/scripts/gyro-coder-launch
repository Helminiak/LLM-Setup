#!/usr/bin/env bash
set -Eeuo pipefail
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
STATE="$HOME/.local/state/gyro-coder"; mkdir -p "$STATE"; LOG="$STATE/startup.log"; : > "$LOG"
fail(){ printf '[GYRO CODER] %s\n' "$*" | tee -a "$LOG" >&2; notify-send 'GYRO CODER startup failed' "$*" 2>/dev/null || true; exit 1; }
wait_ok(){ local u=$1 n=$2; for _ in $(seq 1 "$n"); do curl -fsS "$u" >/dev/null 2>&1 && return 0; sleep 2; done; return 1; }
for u in gyro-coder-l-gpu0.service gyro-coder-l-gpu1.service hindsight.service; do systemctl --user is-active --quiet "$u" || systemctl --user start "$u" >>"$LOG" 2>&1 || fail "Could not start $u"; done
wait_ok http://127.0.0.1:8082/health 90 || fail 'GPU 0 worker did not become healthy.'
wait_ok http://127.0.0.1:8083/health 90 || fail 'GPU 1 worker did not become healthy.'
curl -fsS http://127.0.0.1:8888/health | grep -q '"database":"connected"' || fail 'Hindsight database is not healthy.'
lock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gyro-coder-hermes.lock"; exec 9>"$lock"; flock -n 9 || { notify-send 'GYRO CODER' 'Hermes Supervisor is already running.' 2>/dev/null || true; exit 0; }
command -v gnome-terminal >/dev/null || fail 'GNOME Terminal is unavailable.'
notify-send 'GYRO CODER' 'Workers and Hindsight are ready; opening Hermes Supervisor.' 2>/dev/null || true
gnome-terminal --title='GYRO CODER-L - Hermes Supervisor' -- bash -lc 'export HERMES_HOME="$HOME/.hermes/profiles/gyro-coder-supervisor"; exec hermes chat --tui'
